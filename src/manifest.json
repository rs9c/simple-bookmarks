{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "description": "__MSG_extDisc__",
    "version": "1.0.0",
    "default_locale": "en",
    "permissions": ["storage"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["shared.js", "content/content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["content/content.css"],
            "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "icons": {
        "128": "icon/icon-128.png",
        "48": "icon/icon-48.png",
        "32": "icon/icon-32.png",
        "16": "icon/icon-16.png"
    }
}
